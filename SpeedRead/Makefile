# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  FileGenerator_config = debug
  FileReader_config = debug

else ifeq ($(config),release)
  FileGenerator_config = release
  FileReader_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := FileGenerator FileReader

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

FileGenerator:
ifneq (,$(FileGenerator_config))
	@echo "==== Building FileGenerator ($(FileGenerator_config)) ===="
	@${MAKE} --no-print-directory -C . -f FileGenerator.make config=$(FileGenerator_config)
endif

FileReader:
ifneq (,$(FileReader_config))
	@echo "==== Building FileReader ($(FileReader_config)) ===="
	@${MAKE} --no-print-directory -C . -f FileReader.make config=$(FileReader_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f FileGenerator.make clean
	@${MAKE} --no-print-directory -C . -f FileReader.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   FileGenerator"
	@echo "   FileReader"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"